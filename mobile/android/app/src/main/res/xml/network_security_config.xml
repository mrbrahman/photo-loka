<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext (plain HTTP) traffic. The Photo-Loka server is self-hosted and
  typically runs over HTTP on a LAN (e.g. http://192.168.x.x:9000). Android 9+
  blocks cleartext by default, which silently drops the app's fetches to the
  HTTP server (the WebView page itself is https://localhost, so only outbound
  API/media calls are affected). Permitting cleartext here lets the app reach an
  HTTP server. If/when the server runs over HTTPS, this can be tightened.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
