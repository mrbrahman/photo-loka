# leaflet.markercluster@1.4.1 declares a stale peer dependency (leaflet ~1.3.1)
# but works fine with leaflet 1.9.4 at runtime (the web app uses this exact
# pairing via CDN). legacy-peer-deps lets npm install the known-good combo
# without erroring on the outdated peer range. Keep reproducible across machines/CI.
legacy-peer-deps=true
