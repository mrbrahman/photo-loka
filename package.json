{
  "name": "rewind-replay",
  "version": "0.0.1",
  "description": "Relive every (captured) moment!",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --ignore ./data --ignore ./public server.mjs"
  },
  "keywords": [
    "photos",
    "videos",
    "memories",
    "replay"
  ],
  "author": "Shreyas Jois",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "chokidar": "^3.5.2",
    "compression": "^1.7.4",
    "dateformat": "^5.0.2",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^28.2.0",
    "express": "^4.17.1",
    "fdir": "^6.5.0",
    "morgan": "^1.10.0",
    "node-addon-api": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-gyp": "^10.2.0",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "type": "module",
  "imports": {
    "#config": "./app/config.mjs",
    "#services": "./app/services.mjs",

    "#utils/*": "./app/utils/*.mjs",
    "#db/*": "./app/database/*.mjs",
    "#infra/*": "./app/infrastructure/*.mjs",
    "#jobs/*": "./app/jobs/*.mjs",
    
    "#albums/*": "./app/core/albums/*.mjs",
    "#collections/*": "./app/core/collections/*.mjs",
    "#geo/*": "./app/core/geo/*.mjs",
    "#indexing/*": "./app/core/indexing/*.mjs",
    "#media/*": "./app/core/media/*.mjs",
    "#overlays/*": "./app/core/media/overlays/*",
    "#search/*": "./app/core/search/*.mjs",
    "#sync/*": "./app/core/sync/*.mjs"
  }
}
