# Authentication
JWT_SECRET=your-secret-key-here-change-this

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Data Directory (absolute path)
DATA_DIR=/path/to/data/folder

# Geonames API
GEONAMES_USERNAME=your-geonames-username

# Optional: Logging
# LOG_LEVEL=info
# NO_COLOR=0

# Optional: Indexer mode - 'static' (fixed concurrency) or 'dynamic' (auto-adjusts based on system load)
# INDEXER_MODE=static

# Optional: Node environment
# NODE_ENV=production
