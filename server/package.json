{
  "name": "photo-loka",
  "version": "0.0.1",
  "description": "Your world in photos!",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "create-user": "node --env-file=.env scripts/create-user.mjs",
    "unlock-user": "node --env-file=.env scripts/unlock-user.mjs",
    "generate-token": "node --env-file=.env scripts/generate-token.mjs"
  },
  "keywords": [
    "photos",
    "videos",
    "memories",
    "replay"
  ],
  "author": "Shreyas Jois",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "chokidar": "^3.5.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dateformat": "^5.0.2",
    "exiftool-vendored": "^35.20.0",
    "express": "^4.17.1",
    "fdir": "^6.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-addon-api": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-gyp": "^12.1.0",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "type": "module",
  "imports": {
    "#startup-config": "./app/startup-config.mjs",
    "#runtime-config": "./app/runtime-config.mjs",
    "#services": "./app/services.mjs",
    "#utils/*": "./app/utils/*.mjs",
    "#authn/*": "./app/infrastructure/authn/*.mjs",
    "#db/*": "./app/database/*.mjs",
    "#infra/*": "./app/infrastructure/*.mjs",
    "#jobs/*": "./app/jobs/*.mjs",
    "#albums/*": "./app/core/albums/*.mjs",
    "#collections/*": "./app/core/collections/*.mjs",
    "#geo/*": "./app/core/geo/*.mjs",
    "#indexing/*": "./app/core/indexing/*.mjs",
    "#frame/*": "./app/core/frame/*.mjs",
    "#ml/*": "./app/core/ml/*.mjs",
    "#media/*": "./app/core/media/*.mjs",
    "#overlays/*": "./app/core/media/overlays/*",
    "#search/*": "./app/core/search/*.mjs",
    "#backup/*": "./app/core/backup/*.mjs",
    "#dashboard/*": "./app/core/dashboard/*.mjs"
  }
}
